{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Essential Services",
      "type": "shell",
      "command": "cargo run",
      "inAgents": true,
      "problemMatcher": []
    },
    {
      "label": "Build Essential Services (release)",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build",
      "inAgents": true,
      "problemMatcher": []
    },
    {
      "label": "Build Essential Services Installer",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\installer\\build-installer.ps1"
      ],
      "inAgents": true,
      "problemMatcher": []
    }
  ]
}
